# 复制为 .env 后按需修改；程序只读取环境变量，不读这个文件本身。
# 在 PowerShell 里可以这样注入：Get-Content .env | ForEach-Object { ... } 或直接用系统环境变量。

# ---- 现场摄像头（覆盖 config/cameras.yaml 里的默认值）----
CAM01_URL=rtsp://user:pass@192.168.1.101:554/av0_0
CAM02_URL=rtsp://user:pass@192.168.1.102:554/av0_0
CAM03_URL=
CAM04_URL=

# ---- 告警通知（可选）----
# 钉钉机器人：记得把「安防告警」设为自定义关键词
DINGDING_WEBHOOK=

# ---- 云端协同与 LLM 研判（可选，默认关闭）----
CLOUD_ENDPOINT=
CLOUD_API_KEY=
LLM_API_BASE=
LLM_API_KEY=
